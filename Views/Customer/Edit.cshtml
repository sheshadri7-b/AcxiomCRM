@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Edit Customer</h2>
            <p class="text-muted">Update customer information</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Customers</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post">
                <input type="hidden" asp-for="CustomerId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CustomerCode" class="form-label">Customer Code</label>
                        <input asp-for="CustomerCode" class="form-control" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label">Customer Name *</label>
                        <input asp-for="CustomerName" class="form-control" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" />
                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email *</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone *</label>
                        <input asp-for="Phone" type="tel" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" />
                        <span asp-validation-for="State" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    @if (ViewBag.CanManageAssignments == true)
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label">Assigned Employee</label>
                            <select asp-for="AssignedTo"
                                    asp-items="ViewBag.AssignableUsers"
                                    class="form-select">
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger"></span>
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6">
                            <label class="form-label">Assigned Employee</label>
                            <input class="form-control"
                                   value="@(Model.AssignedUser?.FullName ?? "You")"
                                   readonly />
                            <small class="text-muted">Only Admins and Managers can change assignments.</small>
                        </div>
                    }
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Update Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
