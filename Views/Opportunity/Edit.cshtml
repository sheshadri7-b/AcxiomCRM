
@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Edit Opportunity</h2>
        <p class="text-muted">
            Update opportunity details and sales progress.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.OpportunityId"
                  method="post">

                <input type="hidden" asp-for="OpportunityId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5 class="fw-semibold mb-3">Opportunity Information</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="OpportunityName"
                               class="form-label">
                            Opportunity Name *
                        </label>
                        <input asp-for="OpportunityName"
                               class="form-control" />
                        <span asp-validation-for="OpportunityName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Opportunity ID</label>
                        <input value="@Model.OpportunityId"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId"
                               class="form-label">
                            Link to Customer
                        </label>
                        <select asp-for="CustomerId"
                                class="form-select">
                            <option value="">Select customer</option>
                            @foreach (var customer in ViewBag.Customers)
                            {
                                <option value="@customer.CustomerId">
                                    @customer.CustomerName
                                </option>
                            }
                        </select>
                        <span asp-validation-for="CustomerId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId"
                               class="form-label">
                            Link to Lead
                        </label>
                        <select asp-for="LeadId"
                                class="form-select">
                            <option value="">Select lead</option>
                            @foreach (var lead in ViewBag.Leads)
                            {
                                <option value="@lead.LeadId">
                                    @lead.LeadName (@lead.LeadCode)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="LeadId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label">
                            Opportunity Amount (₹) *
                        </label>
                        <input asp-for="Amount"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="Amount"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-3">Pipeline Information</h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Stage" class="form-label">
                            Opportunity Stage
                        </label>
                        <select asp-for="Stage" class="form-select">
                            @foreach (string stage in ViewBag.Stages)
                            {
                                <option value="@stage">@stage</option>
                            }
                        </select>
                        <span asp-validation-for="Stage"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">
                            Opportunity Status
                        </label>
                        <select asp-for="Status" class="form-select">
                            @foreach (string status in ViewBag.Statuses)
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Probability" class="form-label">
                            Probability (%)
                        </label>
                        <input asp-for="Probability"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" />
                        <span asp-validation-for="Probability"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ExpectedCloseDate"
                               class="form-label">
                            Expected Close Date
                        </label>
                        <input asp-for="ExpectedCloseDate"
                               type="date"
                               class="form-control"
                               asp-format="{0:yyyy-MM-dd}" />
                        <span asp-validation-for="ExpectedCloseDate"
                              class="text-danger"></span>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="col-md-6">
                            <label asp-for="AssignedTo"
                                   class="form-label">
                                Assign To
                            </label>
                            <select asp-for="AssignedTo"
                                    class="form-select">
                                <option value="">Select user</option>
                                @foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Id">
                                        @user.FullName (@user.Email)
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="AssignedTo"
                                  class="text-danger"></span>
                        </div>
                    }

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">
                            Notes
                        </label>
                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="4"></textarea>
                        <span asp-validation-for="Notes"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="alert alert-info">
                    **Weighted Pipeline:** Amount × Probability / 100.
                    This value is recalculated automatically.
                </div>

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to Opportunities
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
