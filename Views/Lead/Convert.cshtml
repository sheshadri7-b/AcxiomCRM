@model AcxiomCRM.Models.ViewModels.LeadConversionViewModel

@{
    ViewData["Title"] = "Convert Lead";
    var lead = ViewBag.Lead as AcxiomCRM.Models.Lead;
}

<h2>Convert Lead</h2>
<p class="text-muted">
    Create a customer and an opportunity from this qualified lead.
</p>

@if (lead != null)
{
    <div class="card mb-4">
        <div class="card-header">
            Lead Information
        </div>
        <div class="card-body">
            <p><strong>Name:</strong> @lead.LeadName</p>
            <p><strong>Email:</strong> @lead.Email</p>
            <p><strong>Phone:</strong> @lead.Phone</p>
            <p><strong>Company:</strong> @lead.CompanyName</p>
            <p><strong>Expected Value:</strong> @lead.ExpectedValue.ToString("C")</p>
        </div>
    </div>
}

<form asp-action="Convert" asp-route-id="@Model.LeadId" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="LeadId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <h4>Opportunity Details</h4>

    <div class="mb-3">
        <label asp-for="OpportunityName" class="form-label"></label>
        <input asp-for="OpportunityName" class="form-control" />
        <span asp-validation-for="OpportunityName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number"
               step="0.01" min="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Probability" class="form-label"></label>
        <input asp-for="Probability" class="form-control"
               type="number" min="0" max="100" />
        <span asp-validation-for="Probability"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ExpectedCloseDate" class="form-label"></label>
        <input asp-for="ExpectedCloseDate" class="form-control"
               type="date" />
        <span asp-validation-for="ExpectedCloseDate"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"
                  rows="3"></textarea>
        <span asp-validation-for="Notes"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Convert Lead
    </button>

    <a asp-action="Details"
       asp-route-id="@Model.LeadId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}