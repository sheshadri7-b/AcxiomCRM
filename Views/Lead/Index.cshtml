
@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Lead Management</h2>
            <p class="text-muted mb-0">Manage and track your sales leads.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Lead
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">
                <div class="row g-3">

                    <div class="col-md-5">
                        <label class="form-label">Search Leads</label>
                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Name, code, email, phone or company" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            @foreach (string status in ViewBag.Statuses)
                            {
                                <option value="@status"
                                        selected="@(ViewBag.Status?.ToString() == status)">
                                    @status
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Priority</label>
                        <select name="priority" class="form-select">
                            <option value="">All Priorities</option>
                            @foreach (string priority in ViewBag.Priorities)
                            {
                                <option value="@priority"
                                        selected="@(ViewBag.Priority?.ToString() == priority)">
                                    @priority
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            Search
                        </button>
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Reset
                        </a>
                    </div>

                </div>
            </form>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Lead Code</th>
                            <th>Lead Name</th>
                            <th>Company</th>
                            <th>Contact</th>
                            <th>Source</th>
                            <th>Expected Value</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var lead in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@lead.LeadCode</td>
                                    <td>@lead.LeadName</td>
                                    <td>@(lead.CompanyName ?? "-")</td>
                                    <td>
                                        <div>@(lead.Email ?? "-")</div>
                                        <small class="text-muted">
                                            @(lead.Phone ?? "-")
                                        </small>
                                    </td>
                                    <td>@lead.Source</td>
                                    <td>@lead.ExpectedValue.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @lead.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (lead.Priority == "High")
                                        {
                                            <span class="badge bg-danger">High</span>
                                        }
                                        else if (lead.Priority == "Medium")
                                        {
                                            <span class="badge bg-warning text-dark">Medium</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Low</span>
                                        }
                                    </td>
                                    <td>@lead.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-info">
                                                View
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@lead.LeadId"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    No leads found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-end">

                        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@ViewBag.Search"
                                   asp-route-status="@ViewBag.Status"
                                   asp-route-priority="@ViewBag.Priority">
                                    @i
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            }

        </div>
    </div>

</div>
