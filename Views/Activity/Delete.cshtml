@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Delete Activity";
}

<div class="container mt-4">
    <h2>Delete Activity</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete this activity?
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Activity Type</dt>
                <dd class="col-sm-9">@Model.ActivityType</dd>

                <dt class="col-sm-3">Activity Date</dt>
                <dd class="col-sm-9">
                    @Model.ActivityDate.ToString("dd MMM yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete"
          asp-route-id="@Model.ActivityId"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>