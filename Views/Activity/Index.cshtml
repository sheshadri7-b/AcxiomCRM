@model IEnumerable<AcxiomCRM.Models.Activity>

@{
    ViewData["Title"] = "Activity Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Activity Management</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Create Activity
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input type="text" name="search" value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search subject, customer or lead..." />
        </div>

        <div class="col-md-3">
            <select name="type" asp-items="ViewBag.Types" class="form-select">
                <option value="">All Activity Types</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="status" asp-items="ViewBag.Statuses" class="form-select">
                <option value="">All Statuses</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Subject</th>
                    <th>Related To</th>
                    <th>Activity Type</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Subject</td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <span>Customer: @item.Customer.CustomerName</span>
                                }
                                else if (item.Lead != null)
                                {
                                    <span>Lead: @item.Lead.LeadName</span>
                                }
                                else
                                {
                                    <span>Not linked</span>
                                }
                            </td>
                            <td>@item.ActivityType</td>
                            <td>@item.ActivityDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else if (item.Status == "Missed")
                                {
                                    <span class="badge bg-danger">Missed</span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-secondary">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "—"
                                    : item.Description)
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.ActivityId"
                                   class="btn btn-sm btn-info">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.ActivityId"
                                   class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.ActivityId"
                                   class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No activities found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>