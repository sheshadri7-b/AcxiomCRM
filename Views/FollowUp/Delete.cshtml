@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-up";
}

<div class="container mt-4">
    <h2>Delete Follow-up</h2>

    <div class="alert alert-danger">
        Are you sure you want to delete this follow-up?
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">
                    @Model.FollowUpDate.ToString("dd MMM yyyy")
                </dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.FollowUpType</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Remarks</dt>
                <dd class="col-sm-9">@Model.Remarks</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete"
          asp-route-id="@Model.FollowUpId"
          method="post"
          class="mt-3">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>